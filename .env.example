# RotazRO Entregador — variáveis de ambiente (NENHUM valor real neste arquivo)

# Supabase — cliente (único backend usado pelo app, sem servidor próprio)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Observabilidade (Sentry) — opcional, app funciona normalmente sem isto.
# Ver docs/ROTazRO_OBSERVABILITY.md antes de configurar em produção.
VITE_SENTRY_DSN=
# "production" | "preview" | "development" — se omitido, cai em
# "development" ao rodar `vite dev` e em "production" num build de produção.
VITE_SENTRY_ENVIRONMENT=

# Amostragem de performance tracing, 0 a 1 (padrão 0.1 = 10% se omitido ou
# inválido). Não subir para 1.0 sem necessidade concreta.
VITE_SENTRY_TRACES_SAMPLE_RATE=

# Só para upload de source maps durante o build (ver
# docs/ROTazRO_OBSERVABILITY.md, "Source maps"). NUNCA usado em runtime do
# APK, NUNCA no bundle — configurar só no ambiente de build.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
