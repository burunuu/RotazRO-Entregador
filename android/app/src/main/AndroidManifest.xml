<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- GPS do RotazRO Entregador -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Push notifications (FCM) — obrigatória a partir do Android 13
         (API 33) para o diálogo de permissão em runtime funcionar; sem
         esta declaração, PushNotifications.requestPermissions() falha
         silenciosamente em API 33+. targetSdkVersion deste projeto é 36. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
                android:label="@string/title_activity_main"
                android:theme="@style/AppTheme.NoActionBarLaunch"
                android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android App Links (https://developer.android.com/training/app-links) —
                 route share links (/e/<token>) and the e-mail confirmation deep link
                 (/auth/confirm). android:autoVerify="true" makes Android check
                 assetlinks.json (see docs/ROTAZRO_APP_LINKS.md in the Web repo) and,
                 if it matches, open these links straight in this app instead of the
                 browser — falls back to the normal chooser/browser otherwise, exactly
                 like any unverified https link. Does not touch the MAIN/LAUNCHER
                 filter above. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="rotazro.lovable.app"
                    android:pathPrefix="/e/" />
                <data
                    android:scheme="https"
                    android:host="rotazro.lovable.app"
                    android:pathPrefix="/auth/confirm" />
            </intent-filter>

        </activity>

        <!-- FCM: ícone padrão para notificações em background (a mensageria
             nativa do Android monta a notificação sem passar pelo código
             JS quando o app não está em foreground). Usa o ícone do app
             existente — trocar por um ícone monocromático dedicado
             (recomendação de design do Android) é uma melhoria futura, não
             um bloqueio: sem isso, o FCM já usa o ícone do app como
             fallback de qualquer forma. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
